# ==============================
# Docker Compose Infrastructure (Root .env)
# ==============================
# These variables are used by docker compose for db/redis services
# Backend-specific configuration is in backend/.env.example

POSTGRES_PORT=5432
POSTGRES_DB=api-analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=changethis

NEXT_PUBLIC_API_URL=changethis

# ==============================
# Caddy reverse proxy (Railway deployment)
# ==============================
# Set these on the Caddy Railway service.
# FRONTEND_DOMAIN and BACKEND_DOMAIN use Railway private networking hostnames.
# NEXT_PUBLIC_API_URL must point at the Caddy service URL (the single entry point).
FRONTEND_DOMAIN=frontend.railway.internal
FRONTEND_PORT=3000
BACKEND_DOMAIN=backend.railway.internal
BACKEND_PORT=8000