POSTGRES_PORT=0
POSTGRES_DB=test
POSTGRES_USER=test
POSTGRES_PASSWORD=test

# ==============================
# Redis
# ==============================
REDIS_URL="memory://"

# ==============================
# API / Security
# ==============================
SECURITY_KEY="test_secret_key"

# ==============================
# Backend
# ==============================
BACKEND_CORS_ORIGINS="http://localhost:3000"
TRUSTED_HOSTS=test