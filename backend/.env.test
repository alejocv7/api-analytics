# ==============================
# Project
# ==============================
PROJECT_NAME="Test Analytics"
PROJECT_DESCRIPTION="Testing Description"
PROJECT_ID=00000000-0000-0000-0000-000000000000
PROJECT_USER=test@test.com
PROJECT_PASSWORD=test

# ==============================
# Environment
# ==============================
ENVIRONMENT=test
ENABLE_SELF_METRICS=false

# ==============================
# Database (Testcontainers override host/port)
# ==============================
POSTGRES_SERVER=localhost
POSTGRES_PORT=0
POSTGRES_DB=test
POSTGRES_USER=test
POSTGRES_PASSWORD=test

# ==============================
# Redis
# ==============================
REDIS_HOST=localhost
REDIS_PASSWORD=test
REDIS_PORT=0
REDIS_DB=0

# ==============================
# API / Security
# ==============================
SECURITY_KEY="test-dev-key-with-more-than-32-bytes"

# ==============================
# Backend
# ==============================
BACKEND_CORS_ORIGINS="http://localhost:3000"
TRUSTED_HOSTS=test
